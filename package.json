{
  "name": "wp-transfer-workspace",
  "private": true,
  "description": "WordPress to Next.js migration accelerator CLI tool",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/howlrs/wp-transfer.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "check:hygiene": "node scripts/check-repository-hygiene.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:package": "node scripts/smoke-packed-cli.mjs",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.3",
    "vitest": "^4.1.3"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "vite": "8.0.16"
    }
  }
}
